# Google Cloud ConsoleでOAuthクライアントIDを取得
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# OpenAI PlatformでAPIキーを取得
OPENAI_API_KEY=sk-...

# Grok APIを使う場合（任意）
GROK_API_KEY=...

# alphaXiv APIトークン（任意）
# ※ v3 APIは基本的に認証不要ですが、トークンがあると制限解除される場合があります
# 自動取得: pnpm run get-token
# 確認: pnpm run check-token
# ALPHAXIV_API_TOKEN=...
